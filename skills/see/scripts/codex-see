#!/usr/bin/env bash
# codex-see — image analysis in a separate session with a text-only return.
#
# Sends one or more images plus a question to Codex CLI running a vision
# model (Luna by default) and prints the model's final text answer to stdout.
#
# Usage:
#   codex-see "<question>" <image> [<image> ...]
#
# Environment:
#   CODEX_VISION_MODEL  override the vision model (default: gpt-5.6-luna)
#
# Exit codes:
#   0 answer printed   2 bad arguments   3 image missing
#   4 codex exec failed (log printed to stderr)   5 codex CLI not installed
set -euo pipefail

MODEL="${CODEX_VISION_MODEL:-gpt-5.6-luna}"

if [ "$#" -lt 2 ]; then
  echo "usage: codex-see \"<question>\" <image> [<image> ...]" >&2
  exit 2
fi

PROMPT="$1"
shift

if ! command -v codex >/dev/null 2>&1; then
  echo "error: codex CLI not found on PATH. Install Codex CLI and authenticate before using this skill." >&2
  exit 5
fi

IMAGE_ARGS=()
for img in "$@"; do
  if [ ! -f "$img" ]; then
    echo "error: image not found: $img" >&2
    exit 3
  fi
  IMAGE_ARGS+=(-i "$img")
done

PREAMBLE='You are the designated image relay, already running in a separate session so the calling agent retains text findings without image data. This task explicitly authorizes you to inspect the attached images directly. Do not start or request another relay; the caller has already performed that delegation. Answer the question with concrete visible observations, defects and uncertainty, grouped by image and requested criterion. Keep the answer concise unless an exhaustive inventory is requested. When multiple images are attached, refer to them as "image 1", "image 2", ... in attachment order. Report only what is visible; if something cannot be determined, say so explicitly. Do not infer behavior from a screenshot. Do not run commands or speculate about source code. The calling agent owns implementation decisions and the review verdict.'

ANSWER="$(mktemp)"
LOG="$(mktemp)"
trap 'rm -f "$ANSWER" "$LOG"' EXIT

if ! codex exec \
    --skip-git-repo-check \
    --ephemeral \
    -s read-only \
    --color never \
    -m "$MODEL" \
    "${IMAGE_ARGS[@]}" \
    -o "$ANSWER" \
    "$PREAMBLE

Question: $PROMPT" >"$LOG" 2>&1 </dev/null; then
  echo "error: codex exec failed (model: $MODEL). Log follows:" >&2
  cat "$LOG" >&2
  exit 4
fi

cat "$ANSWER"
