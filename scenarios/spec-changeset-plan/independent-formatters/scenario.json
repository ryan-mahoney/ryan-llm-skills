{
  "id": "independent-formatters",
  "skill": "spec-changeset-plan",
  "driver": "changeset",
  "status": "ready",
  "phase": "train",
  "purpose": "Implement four independent formatting helpers, one simple operation per module, with no cross-module dependencies. They share no imports or state.",
  "task": "Compile the supplied specification into one executable changeset plan.",
  "fixture": {
    "feature": "independent-formatters"
  },
  "timeout_ms": 480000,
  "execution": {
    "concurrency": 4,
    "review_model": "openai-codex/gpt-6.1-sol:low",
    "repair_model": "openai-codex/gpt-6.1-sol:low",
    "max_repairs": 1,
    "simple_model": "openrouter/inception/mercury-2.5:low",
    "involved_model": "deepseek/deepseek-flash:off",
    "max_tokens": 16000
  },
  "expectation_sources": [
    "input/package/spec.md"
  ],
  "checks": [
    {
      "id": "behavior",
      "kind": "node-check",
      "script": "graders/behavior.mjs",
      "timeout_ms": 10000
    },
    {
      "id": "unrelated",
      "kind": "git-untouched",
      "root": "repo",
      "paths": [
        "keep.txt"
      ]
    }
  ]
}
